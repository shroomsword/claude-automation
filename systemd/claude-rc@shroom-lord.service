# Runs `claude rc` in ~/src/shroom-lord.
#
# Usage: systemctl --user enable --now claude-rc@shroom-lord.service

[Unit]
Description=Claude remote control for project shroom-lord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/shroom-lord
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude rc
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
