# Runs `claude rc` in ~/src/doe.
#
# Usage: systemctl --user enable --now claude-rc@doe.service

[Unit]
Description=Claude remote control for project doe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/doe
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude rc
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
